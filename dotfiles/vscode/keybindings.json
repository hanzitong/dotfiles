
[
    {
        "key": "ctrl+b",
        "command": "workbench.action.terminal.focus",
        // "when": always if commentted out
    },
    {
        "key": "alt+b",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "!terminalViewShowing",
    },
    {
        "key": "alt+b",
        "command": "workbench.action.closePanel",
        "when": "terminalViewShowing",
    },

    {
        "key": "ctrl+e",
        "command": "workbench.files.action.focusFilesExplorer",
        // Also when the explorer has focus: does nothing, and keeps the default ctrl+e (quickOpen) from running
        "when": "explorerViewletVisible",
    },
    {
        // "key": "ctrl+e",
        "key": "alt+e",
        "command": "workbench.view.explorer",
        "when": "!explorerViewletVisible",
    },
    {
        // "key": "ctrl+e",
        "key": "alt+e",
        "command": "workbench.action.closeSidebar",
        "when": "explorerViewletVisible",
    },

    {
        "key": "ctrl+l",    // "key": "ctrl+escape",
        "command": "claude-vscode.focus",
        "when": "editorTextFocus && !config.claudeCode.useTerminal"
    },
    {
        "key": "ctrl+escape",    // "key": "alt+k",
        "command": "claude-vscode.insertAtMention",
        "when": "editorTextFocus"
    },

    /* navigation function */
    // F12: (default) go to definition
    {
        "key": "f11",
        "command": "workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "f10",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },

    /* solve shortcut conflicts between vscode and shell */
    {
        "key": "ctrl+space",
        "command": "-workbench.action.terminal.sendSequence",
        "when": "config.terminal.integrated.enableWin32InputMode && terminalFocus && terminalShellIntegrationEnabled && !accessibilityModeEnabled && terminalShellType == 'pwsh'"
    },
    {
        // Ctrl+M in the terminal turned on "Tab Moves Focus" mode, so Tab stopped reaching the shell
        "key": "ctrl+m",
        "command": "-editor.action.toggleTabFocusMode",
    },

]


